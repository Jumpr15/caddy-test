{
	"apps": {
		"http": {
			"servers": {
				"reverse-proxy-server": {
					"listen": [":2015"],
					"routes": [
						{
							"handle": [{
								"@id": "upstream-handler",
								"handler": "reverse_proxy",
								"load_balancing": {
									"selection_policy": { 
										"policy": "random" 
									}
								},
								"upstreams": [
									{
										"dial": "127.0.0.1:80",
										"@id": "upstream-worker-1"
									},
									{
										"dial": "127.0.0.1:90",
										"@id": "upstream-worker-2"
									}
								]
							}]
						}
					]
				}
			}
		}
	}
}